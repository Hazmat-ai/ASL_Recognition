{
  "name": "sign-language",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:prepare && tsc && vite build",
    "preview": "vite preview",
    "start": "node server/app.mjs",
    "dev:api": "node --watch server/app.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --import tsx --test tests/recognition.test.ts tests/progress.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:unit && npm run build",
    "release:check": "node scripts/release-check.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
